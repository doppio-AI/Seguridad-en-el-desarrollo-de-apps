@model IEnumerable<VulnerableApp.Models.User>

<h2>Buscar Usuarios</h2>

<form method="get">
    <input type="text" name="search" placeholder="Busca usuario..." />
    <button type="submit">Buscar</button>
</form>

@if (Model?.Any() == true)
{
    <table border="1" cellpadding="8" cellspacing="0">
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Balance</th>
        </tr>

        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>$@user.Balance</td>
            </tr>
        }
    </table>
}
else
{
    <p>No hay resultados.</p>
}